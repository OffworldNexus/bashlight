{
    "name": "bashlight",
    "version": "0.1.0",
    "description": "Statically interprets the bash commands LLM agents run and silently rewrites them to match project conventions.",
    "type": "module",
    "private": true,
    "main": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./opencode": "./src/opencode/plugin.ts"
    },
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write . && eslint --fix .",
        "corpus:extract": "bun scripts/corpus/extract.ts",
        "corpus:report": "bun scripts/corpus/report.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "latest",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0",
        "typescript-eslint": "^8.72.1"
    }
}
